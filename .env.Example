APP_ID=your_discord_application_id
DISCORD_TOKEN=your_discord_bot_token
PUBLIC_KEY=your_discord_application_public_key
DATA_DIR=/home/container/data
BOT_NAME=Minokawa
PORT=3000
# Optional: comp rosters (/comp). Redirect to add in the Developer Portal: <PUBLIC_URL>/comp/auth/callback
PUBLIC_URL=https://your-bot-host
DISCORD_CLIENT_SECRET=your_discord_oauth_client_secret
